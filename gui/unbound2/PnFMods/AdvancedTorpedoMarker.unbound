(def constant ATM_LOCK_SCALE 2.5)

(def element WorldTorpedoMarker (_markerEntity:gfx) layout=true
	(scope
		(event evMarkerShow)

		(macro GET_MARKER_ENTITY_COMPONENT 'torpedo')
		(macro VAR_RELATION "_markerEntity")

		(var type:str = "torpedoComponent.type" (event "torpedoComponent.evTypeChanged"))

		(macro GET_MARKER_ENTITY_COMPONENT 'mods_DataComponent')
		(var modData:dict = "mods_DataComponentComponent ? mods_DataComponentComponent.data : {}" (event "mods_DataComponentComponent.evDataChanged"))
		(var isHoming:bool = "'isHoming' in modData ? modData.isHoming : false")

		(var markerIcon:str = "'icon_torpedo_' + type + '_' + relation")
		(var isSpotted:bool = "'isSpotted' in modData ? modData.isSpotted : false")

		(var cameraComponent:gfx = "$datahub.getSingleComponent(CC.camera)")
		(var altVision:bool = "cameraComponent ? cameraComponent.altVision : false" (event "cameraComponent.evAltVisionChanged"))

		(macro TT_GET_PREF _varName="'detectionModePref'" _key="'ttaro.advTorpedoMarker.detection.displayMode'")
		(var detectionMode:number = "null != detectionModePref && null != detectionModePref.value ? detectionModePref.value : TT_CONST.DISPLAY_MODE.ENABLED")
		(var isDetectionVisible:bool = "detectionMode == TT_CONST.DISPLAY_MODE.ADAPTIVE ? altVision : detectionMode == TT_CONST.DISPLAY_MODE.ENABLED")

		(macro TT_GET_PREF _varName="'homingModePref'" _key="'ttaro.advTorpedoMarker.homing.displayMode'")
		(var homingMode:number = "null != homingModePref && null != homingModePref.value ? homingModePref.value : TT_CONST.DISPLAY_MODE.ENABLED")
		(var isHomingVisible:bool = "homingMode == TT_CONST.DISPLAY_MODE.ADAPTIVE ? altVision : homingMode == TT_CONST.DISPLAY_MODE.ENABLED")
	)

	(dispatch evMarkerShow args="{}" on='addedToStage')

	(style
		(width = 0) (height = 0)
		(align = "center|bottom")
	)

	(block
		(block
			(block
				(style
					(bind backgroundImage "'url:../battle_hud/markers/torpedoes/' + markerIcon + '.png'")
					(backgroundSize = "autosize")
				)

				(block
					(bind visible "isHomingVisible")
					(style
						(position = "absolute")
						(hcenter = 0px)
						(vcenter = 0px)
						(pivotX = 50%)
						(pivotY = 50%)
						(alpha = 0)
						(scaleX = "ATM_LOCK_SCALE")
						(scaleY = "ATM_LOCK_SCALE")
						(bind backgroundImage "'url:../ttaro/advanced_torpedo_marker/lock_' + relation + '.png'")
						(backgroundSize = "autosize")
					)
					(controller $Animation
						(bindcall play
							id='homingLock'
							duration=0.25
							easing="isHoming ? Easing.cubic_in : Easing.quad_out"
							action="kill"
							from="{alpha: 0, scaleX: ATM_LOCK_SCALE, scaleY: ATM_LOCK_SCALE}"
							to="{alpha: 1, scaleX: 1, scaleY: 1}"
							reverse="!(isHoming)"
							(bind trigger "isHoming")
						)
					)
				)
			)

			(block
				(bind visible "isSpotted && isDetectionVisible")
				(style
					(position = "absolute")
					(hcenter = 0px)
					(top = -17px)
					(alpha = 0)
					(backgroundImage = "'url:../ttaro/advanced_torpedo_marker/spotted_dot.png'")
					(backgroundSize = "autosize")
				)
				(controller $Animation
					(bindcall play
						id='spotted'
						duration=0.15
						action="kill"
						from="{alpha: 0, top: -17px}"
						to="{alpha: 1, top: -7px}"
						(bind enabled "isSpotted")
					)
				)
			)
		)

		(controller $Animation
			(bindcall play
				duration="0.15"
				from="{alpha: 0, marginBottom: 10, scaleX: 1.5, scaleY: 1.5, ubScaleX: 1.5, ubScaleY: 1.5}"
				to="{alpha: 1, marginBottom: 0, scaleX: 1, scaleY: 1, ubScaleX: 1, ubScaleY: 1}"
				action="kill"
				(event "evMarkerShow")
			)
		)
	)
)